Thumbs.db

# config/ — 운영자가 기기마다 손으로 쓰는 파일 (API 키, 모터 홈 값). *.example 만 추적
config/*
!config/*.example

# pytest
.pytest_cache/

# ruff
.ruff_cache/

# Models (downloaded via models.zip)
models/

# assets/ 는 전부 추적. 예외는 대용량 음원만 (별도 배포)
assets/audio/music/
assets/audio/vocal/

# 프로그램이 실행 중에 쓰는 파일 전부 (DB, 로그, 캐시, 생성 오디오, 평가 산출물)
var/

# External model repositories
external/

# C++ third-party libraries
third_party/


